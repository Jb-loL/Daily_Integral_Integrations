from manim import *

# ============================================================
# DAILY INTEGRAL 1
#
# Integral:
# ∫₁ᵉ x² ln(x) dx
#
# Output:
# 1920 × 1080
# 16:9
# 60 FPS
# ============================================================

config.pixel_width = 1920
config.pixel_height = 1080
config.frame_rate = 60


class DailyIntegral1(Scene):

    def construct(self):

        # ====================================================
        # COLOURS
        # ====================================================
        X_SQ_COLOR = BLUE
        LOG_COLOR = GREEN
        LIMIT_COLOR = YELLOW
        RESULT_COLOR = GOLD

        # ====================================================
        # CLEAR SCREEN HELPER FUNCTION
        # ====================================================
        def clear_screen():
            objects = list(self.mobjects)
            if objects:
                self.play(
                    *[FadeOut(obj) for obj in objects],
                    run_time=0.6
                )

        # ====================================================
        # SCENE 1: TITLE
        # ====================================================
        title = Text("Daily Integral 1", font_size=54)
        subtitle = Text("Beginner Integral", font_size=32).next_to(title, DOWN, buff=0.15)

        self.play(Write(title))
        self.play(FadeIn(subtitle))
        self.wait(2)
        clear_screen()

        # ====================================================
        # SCENE 2: PROBLEM
        # ====================================================
        heading = Text("Evaluate", font_size=42).to_edge(UP, buff=0.7)

        integral = MathTex(
            r"\int_{1}^{e} x^2 \ln(x) \, dx",
            font_size=72
        )

        self.play(Write(heading))
        self.play(Write(integral))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 3: CHOOSE U AND DV (STEP 1)
        # ====================================================
        heading = Text("Step 1: Integration by parts", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"\text{Let } u = \ln(x) \implies du = \frac{1}{x} dx",
            color=LOG_COLOR,
            font_size=56
        )

        eq2 = MathTex(
            r"\text{Let } dv = x^2 dx \implies v = \frac{x^3}{3}",
            color=X_SQ_COLOR,
            font_size=56
        )

        equations = VGroup(eq1, eq2).arrange(DOWN, buff=0.8)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(1)
        self.play(Write(eq2))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 4: APPLY THE FORMULA (STEP 2)
        # ====================================================
        heading = Text("Step 2: Apply the formula", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"\int u \, dv = uv - \int v \, du",
            font_size=60
        )

        eq2 = MathTex(
            r"I = \left[ \frac{x^3}{3} \ln(x) \right]_{1}^{e} - \int_{1}^{e} \frac{x^3}{3} \cdot \frac{1}{x} \, dx",
            font_size=60
        )

        equations = VGroup(eq1, eq2).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(1)
        self.play(Write(eq2))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 5: SIMPLIFY THE INTEGRAL (STEP 3)
        # ====================================================
        heading = Text("Step 3: Simplify the integral", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"I = \left[ \frac{x^3}{3} \ln(x) \right]_{1}^{e} - \frac{1}{3} \int_{1}^{e} x^2 \, dx",
            font_size=64
        )

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 6: EVALUATE (STEP 4)
        # ====================================================
        heading = Text("Step 4: Evaluate", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"\text{Boundary: } \frac{e^3}{3} \ln(e) - \frac{1}{3} \ln(1) = \frac{e^3}{3}",
            color=LIMIT_COLOR,
            font_size=52
        )

        eq2 = MathTex(
            r"\text{Integral: } \frac{1}{3} \left[ \frac{x^3}{3} \right]_{1}^{e} = \frac{e^3}{9} - \frac{1}{9}",
            color=X_SQ_COLOR,
            font_size=52
        )

        equations = VGroup(eq1, eq2).arrange(DOWN, buff=0.8)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(1)
        self.play(Write(eq2))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 7: COMBINE RESULTS (STEP 5)
        # ====================================================
        heading = Text("Step 5: Combine results", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"I = \frac{e^3}{3} - \left( \frac{e^3}{9} - \frac{1}{9} \right)",
            font_size=64
        )

        eq2 = MathTex(
            r"I = \frac{3e^3}{9} - \frac{e^3}{9} + \frac{1}{9} = \frac{2e^3 + 1}{9}",
            color=RESULT_COLOR,
            font_size=64
        )

        equations = VGroup(eq1, eq2).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(2)
        self.play(Write(eq2))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 8: FINAL ANSWER
        # ====================================================
        heading = Text("Final Answer", font_size=46).to_edge(UP, buff=0.8)

        answer = MathTex(
            r"\boxed{\frac{2e^3 + 1}{9}}",
            font_size=90,
            color=RESULT_COLOR
        )

        answer.move_to(ORIGIN + UP * 0.5)

        numerical = MathTex(
            r"\approx 4.574563760",
            font_size=44
        )

        numerical.next_to(answer, DOWN, buff=0.75)

        self.play(Write(heading))
        self.play(Write(answer), run_time=1.5)
        self.play(Flash(answer, color=RESULT_COLOR, flash_radius=1.5))
        self.play(FadeIn(numerical), run_time=0.8)

        self.wait(4)
