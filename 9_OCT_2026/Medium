from manim import *

# ============================================================
# DAILY INTEGRAL #3
# ============================================================

config.pixel_width = 1920
config.pixel_height = 1080
config.frame_rate = 60

# ------------------------------------------------------------
# COLORS
# ------------------------------------------------------------

QUESTION_COLOR = WHITE
VARIABLE_COLOR = BLUE
POSITIVE_COLOR = GREEN
NEGATIVE_COLOR = RED
RESULT_COLOR = YELLOW
LIMIT_COLOR = PURPLE
HIGHLIGHT_COLOR = ORANGE


# ============================================================
# SCENE
# ============================================================

class DailyIntegral3(Scene):

    def construct(self):

        # ====================================================
        # 1. PROBLEM
        # ====================================================

        heading = Text(
            "Daily Integral #3",
            font_size=42
        ).to_edge(UP, buff=0.85)

        integral = MathTex(
            r"\int_0^1"
            r"\frac{\sqrt{x-\sqrt{x-\sqrt{x-\cdots}}}}"
            r"{\sqrt{x+\sqrt{x+\sqrt{x+\cdots}}}}\,dx",
            font_size=58
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(integral))
        self.wait(2)

        self.play(
            FadeOut(integral),
            FadeOut(heading)
        )

        # ====================================================
        # 2. DEFINE A AND B
        # ====================================================

        heading = Text(
            "Step 1: Define the repeating radicals",
            font_size=42
        ).to_edge(UP, buff=0.85)

        definition = VGroup(
            MathTex(
                r"A=\sqrt{x-\sqrt{x-\sqrt{x-\cdots}}}",
                font_size=58,
                color=NEGATIVE_COLOR
            ),
            MathTex(
                r"B=\sqrt{x+\sqrt{x+\sqrt{x+\cdots}}}",
                font_size=58,
                color=POSITIVE_COLOR
            )
        ).arrange(
            DOWN,
            buff=0.55
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(definition))
        self.wait(2)

        self.play(
            FadeOut(definition),
            FadeOut(heading)
        )

        # ====================================================
        # 3. SELF-SIMILAR EQUATIONS
        # ====================================================

        heading = Text(
            "Step 2: Use self-similarity",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equations = VGroup(
            MathTex(
                r"A=\sqrt{x-A}",
                font_size=64,
                color=NEGATIVE_COLOR
            ),
            MathTex(
                r"B=\sqrt{x+B}",
                font_size=64,
                color=POSITIVE_COLOR
            )
        ).arrange(
            DOWN,
            buff=0.6
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equations))
        self.wait(2)

        self.play(
            FadeOut(equations),
            FadeOut(heading)
        )

        # ====================================================
        # 4. SQUARE BOTH EQUATIONS
        # ====================================================

        heading = Text(
            "Step 3: Square both equations",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equations = VGroup(
            MathTex(
                r"A^2=x-A",
                font_size=64,
                color=NEGATIVE_COLOR
            ),
            MathTex(
                r"B^2=x+B",
                font_size=64,
                color=POSITIVE_COLOR
            )
        ).arrange(
            DOWN,
            buff=0.6
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equations))
        self.wait(2)

        self.play(
            FadeOut(equations),
            FadeOut(heading)
        )

        # ====================================================
        # 5. REARRANGE
        # ====================================================

        heading = Text(
            "Step 4: Express x in terms of A and B",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equations = VGroup(
            MathTex(
                r"x=A^2+A",
                font_size=64,
                color=NEGATIVE_COLOR
            ),
            MathTex(
                r"x=B^2-B",
                font_size=64,
                color=POSITIVE_COLOR
            )
        ).arrange(
            DOWN,
            buff=0.6
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equations))
        self.wait(2)

        self.play(
            FadeOut(equations),
            FadeOut(heading)
        )

        # ====================================================
        # 6. EQUATE
        # ====================================================

        heading = Text(
            "Step 5: Equate the two expressions for x",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation = MathTex(
            r"A^2+A=B^2-B",
            font_size=68
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation))
        self.wait(2)

        self.play(
            FadeOut(equation),
            FadeOut(heading)
        )

        # ====================================================
        # 7. FACTOR
        # ====================================================

        heading = Text(
            "Step 6: Factor the equation",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation1 = MathTex(
            r"A^2-B^2+A+B=0",
            font_size=64
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation2 = MathTex(
            r"(A+B)(A-B+1)=0",
            font_size=64
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation1))
        self.wait(1)

        self.play(
            Transform(equation1, equation2)
        )
        self.wait(2)

        self.play(
            FadeOut(equation1),
            FadeOut(heading)
        )

        # ====================================================
        # 8. POSITIVE ROOT
        # ====================================================

        heading = Text(
            "Step 7: Select the valid factor",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation1 = MathTex(
            r"A+B>0",
            font_size=64,
            color=POSITIVE_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation2 = MathTex(
            r"A-B+1=0",
            font_size=64
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation3 = MathTex(
            r"\boxed{B=A+1}",
            font_size=70,
            color=RESULT_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation1))
        self.wait(1)

        self.play(
            FadeOut(equation1)
        )

        self.play(
            Write(equation2)
        )

        self.wait(1)

        self.play(
            FadeOut(equation2)
        )

        self.play(
            Write(equation3)
        )

        self.wait(2)

        self.play(
            FadeOut(equation3),
            FadeOut(heading)
        )

        # ====================================================
        # 9. SOLVE FOR A
        # ====================================================

        heading = Text(
            "Step 8: Solve for A",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation1 = MathTex(
            r"A^2+A=x",
            font_size=64
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation2 = MathTex(
            r"A^2+A-x=0",
            font_size=64
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation3 = MathTex(
            r"A=\frac{-1\pm\sqrt{1+4x}}{2}",
            font_size=64
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation4 = MathTex(
            r"A=\frac{\sqrt{1+4x}-1}{2}",
            font_size=64,
            color=RESULT_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation1))
        self.wait(1)

        self.play(
            Transform(equation1, equation2)
        )
        self.wait(1)

        self.play(
            Transform(equation1, equation3)
        )
        self.wait(1)

        self.play(
            Transform(equation1, equation4)
        )
        self.wait(2)

        self.play(
            FadeOut(equation1),
            FadeOut(heading)
        )

        # ====================================================
        # 10. SOLVE FOR B
        # ====================================================

        heading = Text(
            "Step 9: Solve for B",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation1 = MathTex(
            r"B=A+1",
            font_size=64
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation2 = MathTex(
            r"B=\frac{\sqrt{1+4x}-1}{2}+1",
            font_size=60
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation3 = MathTex(
            r"B=\frac{\sqrt{1+4x}+1}{2}",
            font_size=64,
            color=RESULT_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation1))
        self.wait(1)

        self.play(
            Transform(equation1, equation2)
        )
        self.wait(1)

        self.play(
            Transform(equation1, equation3)
        )
        self.wait(2)

        self.play(
            FadeOut(equation1),
            FadeOut(heading)
        )

        # ====================================================
        # 11. FORM THE RATIO
        # ====================================================

        heading = Text(
            "Step 10: Simplify the ratio",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation1 = MathTex(
            r"\frac{A}{B}",
            font_size=68
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation2 = MathTex(
            r"=\frac{\sqrt{1+4x}-1}"
            r"{\sqrt{1+4x}+1}",
            font_size=64,
            color=RESULT_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation1))
        self.wait(1)

        self.play(
            Transform(equation1, equation2)
        )
        self.wait(2)

        self.play(
            FadeOut(equation1),
            FadeOut(heading)
        )

        # ====================================================
        # 12. SUBSTITUTE INTO THE INTEGRAL
        # ====================================================

        heading = Text(
            "Step 11: Rewrite the integral",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation = MathTex(
            r"I=\int_0^1"
            r"\frac{\sqrt{1+4x}-1}"
            r"{\sqrt{1+4x}+1}\,dx",
            font_size=58
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation))
        self.wait(2)

        self.play(
            FadeOut(equation),
            FadeOut(heading)
        )

        # ====================================================
        # 13. SUBSTITUTION
        # ====================================================

        heading = Text(
            "Step 12: Make a substitution",
            font_size=42
        ).to_edge(UP, buff=0.85)

        substitution = MathTex(
            r"u=\sqrt{1+4x}",
            font_size=68,
            color=VARIABLE_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(substitution))
        self.wait(2)

        self.play(
            FadeOut(substitution),
            FadeOut(heading)
        )

        # ====================================================
        # 14. DIFFERENTIAL
        # ====================================================

        heading = Text(
            "Step 13: Find dx",
            font_size=42
        ).to_edge(UP, buff=0.85)

        differential = MathTex(
            r"u^2=1+4x",
            font_size=58
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(differential))
        self.wait(1)

        self.play(
            FadeOut(differential)
        )

        differential = MathTex(
            r"2u\,du=4\,dx"
            r"\;\rightarrow\;"
            r"dx=\frac{u}{2}\,du",
            font_size=58
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(differential))
        self.wait(2)

        self.play(
            FadeOut(differential),
            FadeOut(heading)
        )

        # ====================================================
        # 15. CHANGE LIMITS
        # ====================================================

        heading = Text(
            "Step 14: Change the limits",
            font_size=42
        ).to_edge(UP, buff=0.85)

        lower = MathTex(
            r"x=0\;\rightarrow\;u=\sqrt{1+4(0)}=1",
            font_size=54,
            color=LIMIT_COLOR
        )

        upper = MathTex(
            r"x=1\;\rightarrow\;u=\sqrt{1+4(1)}=\sqrt5",
            font_size=54,
            color=LIMIT_COLOR
        )

        limits = VGroup(
            lower,
            upper
        ).arrange(
            DOWN,
            buff=0.55
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(limits))
        self.wait(2)

        self.play(
            FadeOut(limits),
            FadeOut(heading)
        )

        # ====================================================
        # 16. SUBSTITUTE EVERYTHING
        # ====================================================

        heading = Text(
            "Step 15: Substitute into the integral",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation = MathTex(
            r"I=\frac12\int_1^{\sqrt5}"
            r"\frac{u(u-1)}{u+1}\,du",
            font_size=62
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation))
        self.wait(2)

        self.play(
            FadeOut(equation),
            FadeOut(heading)
        )

        # ====================================================
        # 17. POLYNOMIAL DIVISION
        # ====================================================

        heading = Text(
            "Step 16: Simplify the integrand",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation1 = MathTex(
            r"\frac{u(u-1)}{u+1}"
            r"=\frac{u^2-u}{u+1}",
            font_size=60
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        equation2 = MathTex(
            r"\frac{u^2-u}{u+1}"
            r"=u-2+\frac{2}{u+1}",
            font_size=60,
            color=RESULT_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation1))
        self.wait(1)

        self.play(
            Transform(equation1, equation2)
        )
        self.wait(2)

        self.play(
            FadeOut(equation1),
            FadeOut(heading)
        )

        # ====================================================
        # 18. INTEGRATE
        # ====================================================

        heading = Text(
            "Step 17: Integrate",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation = MathTex(
            r"I=\frac12\int_1^{\sqrt5}"
            r"\left(u-2+\frac{2}{u+1}\right)du",
            font_size=56
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation))
        self.wait(2)

        self.play(
            FadeOut(equation)
        )

        equation = MathTex(
            r"I=\left[\frac{u^2}{4}-u+\ln(u+1)\right]_1^{\sqrt5}",
            font_size=56
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(equation))
        self.wait(2)

        self.play(
            FadeOut(equation),
            FadeOut(heading)
        )

        # ====================================================
        # 19. EXACT RESULT
        # ====================================================

        heading = Text(
            "Step 18: Simplify the result",
            font_size=42
        ).to_edge(UP, buff=0.85)

        equation = MathTex(
            r"I=2-\sqrt5+\ln\left(\frac{\sqrt5+1}{2}\right)",
            font_size=58,
            color=RESULT_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(Write(equation))
        self.wait(2)

        self.play(
            FadeOut(equation),
            FadeOut(heading)
        )

        # ====================================================
        # 20. FINAL NUMERICAL ANSWER
        # ====================================================

        heading = Text(
            "Final Answer",
            font_size=48
        ).to_edge(UP, buff=0.85)

        result = MathTex(
            r"\boxed{0.2451438476}",
            font_size=82,
            color=RESULT_COLOR
        ).next_to(
            heading,
            DOWN,
            buff=0.8
        )

        self.play(Write(heading))
        self.play(
            Write(result),
            run_time=1.5
        )

        self.wait(4)
