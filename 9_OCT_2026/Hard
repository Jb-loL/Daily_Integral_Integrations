from manim import *

# ============================================================
# DAILY INTEGRAL #4
#
# Integral:
# ∫₀¹ Σ (from n=1 to ∞) x³ tan⁻¹( (x/n(n+1)) / (1 + x²/n(n+1)) ) dx
#
# Output:
# 1920 × 1080
# 16:9
# 60 FPS
# ============================================================

config.pixel_width = 1920
config.pixel_height = 1080
config.frame_rate = 60


class DailyIntegral4(Scene):

    def construct(self):

        # ====================================================
        # COLOURS
        # ====================================================
        TRIG_COLOR = BLUE
        SUM_COLOR = GREEN
        LIMIT_COLOR = YELLOW
        POLY_COLOR = PURPLE
        RESULT_COLOR = GOLD

        # ====================================================
        # CLEAR SCREEN HELPER FUNCTION
        # ====================================================
        def clear_screen():
            objects = list(self.mobjects)
            if objects:
                self.play(
                    *[FadeOut(obj) for obj in objects],
                    run_time=0.6
                )

        # ====================================================
        # SCENE 1: TITLE
        # ====================================================
        title = Text("Daily Integral #4", font_size=54)
        subtitle = Text("Hard Integral", font_size=32).next_to(title, DOWN, buff=0.15)

        self.play(Write(title))
        self.play(FadeIn(subtitle))
        self.wait(2)
        clear_screen()

        # ====================================================
        # SCENE 2: PROBLEM
        # ====================================================
        heading = Text("Evaluate", font_size=42).to_edge(UP, buff=0.7)

        integral = MathTex(
            r"\int_{0}^{1} \sum_{n=1}^{\infty} x^3 \tan^{-1}\left( \frac{\frac{x}{n(n+1)}}{1 + \frac{x^2}{n(n+1)}} \right) dx",
            font_size=60
        )

        self.play(Write(heading))
        self.play(Write(integral))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 3: SIMPLIFY ARCTAN (STEP 1)
        # ====================================================
        heading = Text("Step 1: Simplify the arctangent", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"\tan^{-1}(A) - \tan^{-1}(B) = \tan^{-1}\left( \frac{A - B}{1 + AB} \right)",
            font_size=56
        )

        eq2 = MathTex(
            r"\text{Let } A = \frac{x}{n} \text{ and } B = \frac{x}{n+1}",
            font_size=56
        )

        eq3 = MathTex(
            r"\tan^{-1}\left( \frac{\frac{x}{n(n+1)}}{1 + \frac{x^2}{n(n+1)}} \right) = \tan^{-1}\left(\frac{x}{n}\right) - \tan^{-1}\left(\frac{x}{n+1}\right)",
            color=TRIG_COLOR,
            font_size=48
        )

        equations = VGroup(eq1, eq2, eq3).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(1)
        self.play(Write(eq2))
        self.wait(1)
        self.play(Write(eq3))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 4: TELESCOPING SUM (STEP 2)
        # ====================================================
        heading = Text("Step 2: Evaluate the telescoping sum", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"S = \sum_{n=1}^{\infty} x^3 \left[ \tan^{-1}\left(\frac{x}{n}\right) - \tan^{-1}\left(\frac{x}{n+1}\right) \right]",
            font_size=56
        )

        eq2 = MathTex(
            r"S = x^3 \Big[ \left( \tan^{-1}(x) - \tan^{-1}(x/2) \right) + \left( \tan^{-1}(x/2) - \tan^{-1}(x/3) \right) + \dots \Big]",
            font_size=48
        )

        eq3 = MathTex(
            r"S = x^3 \left( \tan^{-1}(x) - 0 \right) = x^3 \tan^{-1}(x)",
            color=SUM_COLOR,
            font_size=64
        )

        equations = VGroup(eq1, eq2, eq3).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(1)
        self.play(Write(eq2))
        self.wait(2)
        self.play(Write(eq3))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 5: NEW INTEGRAL (STEP 3)
        # ====================================================
        heading = Text("Step 3: The new integral", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"I = \int_{0}^{1} x^3 \tan^{-1}(x) \, dx",
            font_size=72
        )

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 6: INTEGRATION BY PARTS SETUP (STEP 4)
        # ====================================================
        heading = Text("Step 4: Integration by parts", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"\text{Let } u = \tan^{-1}(x) \implies du = \frac{1}{1+x^2} dx",
            font_size=56
        )

        eq2 = MathTex(
            r"\text{Let } dv = x^3 dx \implies v = \frac{x^4}{4}",
            font_size=56
        )

        eq3 = MathTex(
            r"I = \left[ \frac{x^4}{4} \tan^{-1}(x) \right]_{0}^{1} - \int_{0}^{1} \frac{x^4}{4(1+x^2)} dx",
            font_size=60
        )

        equations = VGroup(eq1, eq2, eq3).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(1)
        self.play(Write(eq2))
        self.wait(1)
        self.play(Write(eq3))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 7: APPLY LIMITS TO BOUNDARY TERM (STEP 5)
        # ====================================================
        heading = Text("Step 5: Evaluate the boundary term", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"\left[ \frac{x^4}{4} \tan^{-1}(x) \right]_{0}^{1} = \frac{1}{4} \tan^{-1}(1) - 0",
            font_size=64
        )

        eq2 = MathTex(
            r"= \frac{1}{4} \left(\frac{\pi}{4}\right) = \frac{\pi}{16}",
            color=LIMIT_COLOR,
            font_size=72
        )

        equations = VGroup(eq1, eq2).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(2)
        self.play(Write(eq2))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 8: REMAINING INTEGRAL (STEP 6)
        # ====================================================
        heading = Text("Step 6: Evaluate the remaining integral", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"-\frac{1}{4} \int_{0}^{1} \frac{x^4}{1+x^2} dx",
            font_size=64
        )

        eq2 = MathTex(
            r"\frac{x^4}{1+x^2} = x^2 - 1 + \frac{1}{x^2+1}",
            color=POLY_COLOR,
            font_size=64
        )

        eq3 = MathTex(
            r"-\frac{1}{4} \int_{0}^{1} \left( x^2 - 1 + \frac{1}{x^2+1} \right) dx",
            font_size=60
        )

        equations = VGroup(eq1, eq2, eq3).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(1)
        self.play(Write(eq2))
        self.wait(2)
        self.play(Write(eq3))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 9: INTEGRATE REMAINING (STEP 7)
        # ====================================================
        heading = Text("Step 7: Integrate", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"-\frac{1}{4} \left[ \frac{x^3}{3} - x + \tan^{-1}(x) \right]_{0}^{1}",
            font_size=64
        )

        eq2 = MathTex(
            r"= -\frac{1}{4} \left( \frac{1}{3} - 1 + \frac{\pi}{4} \right) = -\frac{1}{4} \left( -\frac{2}{3} + \frac{\pi}{4} \right)",
            font_size=56
        )

        eq3 = MathTex(
            r"= \frac{1}{6} - \frac{\pi}{16}",
            color=POLY_COLOR,
            font_size=72
        )

        equations = VGroup(eq1, eq2, eq3).arrange(DOWN, buff=0.6)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(2)
        self.play(Write(eq2))
        self.wait(2)
        self.play(Write(eq3))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 10: COMBINE RESULTS (STEP 8)
        # ====================================================
        heading = Text("Step 8: Combine results", font_size=42).to_edge(UP, buff=0.7)

        eq1 = MathTex(
            r"I = \frac{\pi}{16} + \left( \frac{1}{6} - \frac{\pi}{16} \right)",
            font_size=72
        )

        eq2 = MathTex(
            r"I = \frac{1}{6}",
            color=RESULT_COLOR,
            font_size=80
        )

        equations = VGroup(eq1, eq2).arrange(DOWN, buff=0.8)

        self.play(Write(heading))
        self.play(Write(eq1))
        self.wait(2)
        self.play(Write(eq2))
        self.wait(3)
        clear_screen()

        # ====================================================
        # SCENE 11: FINAL ANSWER
        # ====================================================
        heading = Text("Final Answer", font_size=46).to_edge(UP, buff=0.8)

        answer = MathTex(
            r"\boxed{\frac{1}{6}}",
            font_size=100,
            color=RESULT_COLOR
        )

        answer.move_to(ORIGIN + UP * 0.5)

        numerical = MathTex(
            r"\approx 0.1666666667",
            font_size=44
        )

        numerical.next_to(answer, DOWN, buff=0.75)

        self.play(Write(heading))
        self.play(Write(answer), run_time=1.5)
        self.play(Flash(answer, color=RESULT_COLOR, flash_radius=1.5))
        self.play(FadeIn(numerical), run_time=0.8)

        self.wait(4)
